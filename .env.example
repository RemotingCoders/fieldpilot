# Vertex AI / Gemini
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=fieldpilot-agentic
GOOGLE_CLOUD_LOCATION=us-central1
FIELDPILOT_MODEL=gemini-3.5-flash

# Leave unset to use the free offline travel estimator.
# Setting this opts in to billed Routes API calls.
# FIELDPILOT_MAPS_API_KEY=

# Shared key for POST /intake and /intake/multimodal over HTTP. Unset locally
# means those endpoints are open; on Cloud Run the deploy script supplies it
# from Secret Manager and the service refuses intake without it.
# FIELDPILOT_API_KEY=

# Firestore / Pub/Sub
FIRESTORE_DATABASE=(default)
PUBSUB_TOPIC_EVENTS=fieldpilot-events
